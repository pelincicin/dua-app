# Firebase Web config — gercek degerleri Google Cloud Console > Firebase projesinden al.
# Yerel gelistirme: bu dosyayi ".env" olarak kopyalayip degerleri doldur.
# EAS build: ayni degiskenleri EAS ortamina ekle, orn:
#   eas env:set --environment production --environment preview --environment development \
#     --name EXPO_PUBLIC_FIREBASE_API_KEY --value "<deger>" --visibility plaintext --non-interactive
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
