{
  "expo": {
    "name": "Huzur: Zikirmatik ve Dualar",
    "slug": "huzur-zikirmatik-ve-dualar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1B4332",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pelincicin.huzurzikirmatikvedualar"
    },
    "android": {
      "package": "com.pelincicin.huzurzikirmatikvedualar",
      "permissions": [
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1B4332"
        }
      ],
      "expo-audio",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}