{
  "expo": {
    "name": "Huzur: Zikirmatik ve Dualar",
    "slug": "dua_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1B4332",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pelincicin.huzurzikirmatikvedualar"
    },
    "android": {
      "package": "com.pelincicin.huzurzikirmatikvedualar",
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#1B4332"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1B4332",
          "dark": {
            "image": "./assets/images/logo.png",
            "backgroundColor": "#1B4332"
          }
        }
      ],
      "expo-audio",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#1B4332",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}